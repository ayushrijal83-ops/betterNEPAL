# Copy to .env and fill in. NEVER commit .env.

# development | testing | production
FLASK_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Comma-separated allowed origins for the frontend.
# Use explicit origins in production, never "*".
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

HOST=127.0.0.1
PORT=5000

# --- Database -------------------------------------------------------------
# Either set a full DATABASE_URL (it wins), or leave it blank and set the
# POSTGRES_* parts below. Testing always uses in-memory SQLite and ignores both.
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/betternepal

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=betternepal
POSTGRES_USER=betternepal
POSTGRES_PASSWORD=

# Set to "true" to log every SQL statement in development.
SQLALCHEMY_ECHO=false

# --- Authentication -------------------------------------------------------
# Optional. Defaults to SECRET_KEY when blank; set it to rotate the token
# signing key independently. Must be at least 32 bytes in production (HS256,
# RFC 7518). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Access tokens are short-lived because logout cannot revoke one that has
# already been issued; this window is the real revocation delay.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI -------------------------------------------------------------------
# Optional. Leave blank and every AI endpoint returns 503 "not configured"
# rather than failing - the platform runs fine with no LLM provider at all.
# NOTE: google-generativeai is deprecated upstream in favour of google-genai;
# app/services/ai_service.py isolates the SDK behind BaseAIService.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Metres to search when looking for duplicate reports near a given one.
AI_DUPLICATE_RADIUS_METRES=100

# --- Ollama (self-hosted; preferred over Gemini when any node is set) ------
# Reached through Ollama's OpenAI-compatible /v1 endpoint, so no report text
# leaves your network. Any node may be blank - roles degrade independently, and
# a single-node setup is fine (the others fall back to it).
#
#   vision node = GPU box: the assistant and image analysis
#   text node   = CPU box: classification and severity
#   embed node  = CPU box: vectors for duplicate detection (not wired yet)
OLLAMA_VISION_NODE=
OLLAMA_TEXT_NODE=
OLLAMA_EMBED_NODE=

OLLAMA_VISION_MODEL=qwen2.5:7b
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Ollama Disaster Dispatch (Victus) -------------------------------------
# Dedicated endpoint for disaster triage. If not set, falls back to
# OLLAMA_TEXT_NODE. Use a separate node to keep disaster triage from
# contending with chat/assistant traffic.
OLLAMA_DISPATCH_NODE=
OLLAMA_DISPATCH_MODEL=qwen2.5:3b

# Generous, because a 3B model on a CPU is not fast. Still finite: a hung node
# must not hold a worker open forever.
OLLAMA_TIMEOUT_SECONDS=120
# How long an unreachable node is left alone before being probed again, so one
# switched-off machine does not add its connect timeout to every request.
OLLAMA_HEALTH_TTL_SECONDS=60

# --- Rate limiting --------------------------------------------------------
RATELIMIT_ENABLED=true
# In-process memory by default. That is correct for ONE worker and wrong for
# several: with `gunicorn -w 4` each worker keeps its own counters, so a
# "10 per minute" limit actually admits 40. Point this at a shared redis://
# before running more than one worker.
# REQUIRED in production: set this to a redis:// URI (auth/TLS supported via
# the URI itself, e.g. rediss://:password@host:6379/0) - production refuses
# to start with memory:// otherwise. Never expose Redis publicly; it should
# only be reachable from the app's own workers.
RATELIMIT_STORAGE_URI=memory://

# --- Refresh-token cookie -------------------------------------------------
# Issued HttpOnly alongside the JSON body, so XSS cannot read it.
# Secure MUST stay true in production - production refuses to start otherwise.
# It is false in development only because localhost is not HTTPS and a Secure
# cookie there is silently never sent.
REFRESH_COOKIE_NAME=bn_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax
